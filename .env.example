# Copy to .env.local (or set in your host's environment) and rebuild.

# Google Analytics 4 measurement ID. Defaults to the Firebase project's GA4 stream (G-1301DTCMNR).
NEXT_PUBLIC_GA_ID=

# Google Search Console, "HTML tag" verification method: just the content="..." value.
GOOGLE_SITE_VERIFICATION=

# Contact form email alerts via Resend (https://resend.com). Leave empty to only save to Firebase.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=umair@artemisuav.com
# Sender must be on a domain verified in Resend.
CONTACT_NOTIFY_FROM=Artemis UAV website <website@artemisuav.com>
